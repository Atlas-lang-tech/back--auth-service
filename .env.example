# ===========================
# APPLICATION
# ===========================
QUARKUS_APPLICATION_NAME=auth-service
QUARKUS_HTTP_PORT=8080

# ===========================
# DATABASE (PostgreSQL)
# ===========================
QUARKUS_DATASOURCE_DB_KIND=postgresql
QUARKUS_DATASOURCE_USERNAME=auth_user
QUARKUS_DATASOURCE_PASSWORD=auth_pass
QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://postgres:5432/auth_db

# Connection pool
QUARKUS_DATASOURCE_JDBC_MIN_SIZE=2
QUARKUS_DATASOURCE_JDBC_MAX_SIZE=10

# ===========================
# HIBERNATE ORM
# ===========================
QUARKUS_HIBERNATE_ORM_DATABASE_GENERATION=none
QUARKUS_HIBERNATE_ORM_LOG_SQL=false
QUARKUS_HIBERNATE_ORM_PHYSICAL_NAMING_STRATEGY=org.hibernate.boot.model.naming.CamelCaseToUnderscoresNamingStrategy

# ===========================
# FLYWAY (Database migrations)
# ===========================
QUARKUS_FLYWAY_MIGRATE_AT_START=true
QUARKUS_FLYWAY_LOCATIONS=classpath:db/migration
QUARKUS_FLYWAY_BASELINE_ON_MIGRATE=true

# ===========================
# JWT
# ===========================
MP_JWT_VERIFY_ISSUER=https://atlas.org/auth
MP_JWT_VERIFY_PUBLICKEY_LOCATION=META-INF/resources/publicKey.pem
SMALLRYE_JWT_SIGN_KEY_LOCATION=META-INF/resources/privateKey.pem

# Access token TTL (15 minutes)
ATLAS_JWT_ACCESS_TOKEN_EXPIRY=900

# Refresh token TTL (7 days in seconds)
ATLAS_JWT_REFRESH_TOKEN_EXPIRY=604800

# ===========================
# REDIS
# ===========================
QUARKUS_REDIS_HOSTS=redis://redis:6379
QUARKUS_REDIS_TIMEOUT=10s

# ===========================
# KAFKA
# ===========================
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Producer — user events
MP_MESSAGING_OUTGOING_USER_EVENTS_CONNECTOR=smallrye-kafka
MP_MESSAGING_OUTGOING_USER_EVENTS_TOPIC=user-events
MP_MESSAGING_OUTGOING_USER_EVENTS_VALUE_SERIALIZER=org.apache.kafka.common.serialization.StringSerializer

# ===========================
# gRPC
# ===========================
QUARKUS_GRPC_SERVER_PORT=9000
QUARKUS_GRPC_SERVER_ENABLE_REFLECTION_SERVICE=true

# ===========================
# SWAGGER / OPENAPI
# ===========================
QUARKUS_SWAGGER_UI_ALWAYS_INCLUDE=true
QUARKUS_SWAGGER_UI_PATH=/q/swagger-ui
QUARKUS_SMALLRYE_OPENAPI_PATH=/q/openapi
MP_OPENAPI_EXTENSIONS_SMALLRYE_INFO_TITLE=Auth Service API
MP_OPENAPI_EXTENSIONS_SMALLRYE_INFO_VERSION=1.0.0

# ===========================
# HEALTH
# ===========================
QUARKUS_SMALLRYE_HEALTH_UI_ALWAYS_INCLUDE=true

# ===========================
# LOGGING
# ===========================
QUARKUS_LOG_LEVEL=INFO
QUARKUS_LOG_CATEGORY_ORG_ATLAS_LEVEL=DEBUG

# ===========================
# JAVA OPTIONS
# ===========================
JAVA_OPTS=-Xmx512m -Xms256m

# ===========================
# DEVELOPMENT MODE
# ===========================
# Uncomment for development
# QUARKUS_PROFILE=dev
# QUARKUS_HIBERNATE_ORM_LOG_SQL=true
# QUARKUS_LOG_CATEGORY_ORG_ATLAS_LEVEL=DEBUG
